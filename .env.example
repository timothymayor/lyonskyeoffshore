# Lyonskye Offshore Marine Environment Variables

# APP_URL: Canonical website domain
APP_URL="https://lyonskye.com"

# Server Port (default 3000)
PORT=3000

# Operations Contact Email Configuration
CONTACT_EMAIL="enquiries@lyonskye.com"

# Optional SMTP / Transactional Email Service Settings
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Gemini API Key (Injected automatically in Cloud Run)
GEMINI_API_KEY=""
